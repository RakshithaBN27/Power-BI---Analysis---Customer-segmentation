				    #"Renamed Columns" = Table.RenameColumns(#"Changed column type",{{"Last 6 Months Purchases", "Last 6 Months Purchases"}})
				in
				  #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

